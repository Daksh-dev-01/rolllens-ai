# Local backend settings. Copy the required values into the project-root .env.
# Keep this file free of real credentials.
ROLLLENS_AI_PROVIDER=mock
ROLLLENS_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ROLLLENS_AI_MODEL=gemma-4-26b-a4b-it
ROLLLENS_AI_API_KEY=replace_with_your_private_key
ROLLLENS_DATABASE_URL=sqlite:///./rolllens_demo.db
ROLLLENS_STORAGE_DIR=./private_uploads
ROLLLENS_MAX_UPLOAD_MB=25
ROLLLENS_DEMO_MODE=true
